{
  "schemaVersion": 1,
  "id": "microdurability-armor-bars",
  "version": "${version}",
  "name": "microDurability Armor Bars",
  "description": "Tiny armor durability bars above the hotbar. A stripped-down version of microDurability by pajic: armor bars only, no low-durability warning, no config dependency.",
  "authors": ["Hiveko"],
  "contributors": ["pajic (microDurability)"],
  "contact": {
    "sources": "https://github.com/Hiveko75/microdurability-armor-bars",
    "issues": "https://github.com/Hiveko75/microdurability-armor-bars/issues"
  },
  "license": "MIT",
  "icon": "assets/microdurability-armor-bars/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.hiveko.armorbars.ArmorBars"]
  },
  "depends": {
    "fabricloader": ">=0.19.2",
    "fabric-api": "*",
    "minecraft": "${minecraft_range}",
    "java": ">=25"
  },
  "breaks": {
    "microdurability": "*"
  }
}
